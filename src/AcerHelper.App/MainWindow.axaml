<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AcerHelper.App.ViewModels"
        xmlns:hw="using:AcerHelper.Hardware"
        xmlns:local="using:AcerHelper.App"
        xmlns:ctl="using:AcerHelper.App.Controls"
        x:Class="AcerHelper.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="AcerHelper"
        Width="440" Height="640"
        MinWidth="400" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.metric">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,4,0,0">
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
    </Border>

    <ScrollViewer>
      <StackPanel>

        <!-- Sensors -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="SENSORS" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">

              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Classes="label" Text="CPU temperature" />
                <TextBlock Classes="metric" Text="{Binding CpuTemp}" />
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                <TextBlock Classes="label" Text="System temperature" />
                <TextBlock Classes="metric" Text="{Binding SystemTemp}" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                <TextBlock Classes="label" Text="CPU fan" />
                <TextBlock Classes="metric" Text="{Binding CpuFan}" />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                <TextBlock Classes="label" Text="GPU fan" />
                <TextBlock Classes="metric" Text="{Binding GpuFan}" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Classes="label" Text="GPU temperature" />
                <TextBlock Classes="metric" Text="{Binding GpuTemp}" />
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock Classes="label" Text="Fan mode" />
                <TextBlock Classes="metric" Text="{Binding FanModeText}" />
              </StackPanel>

            </Grid>
          </StackPanel>
        </Border>

        <!-- Thermal profile -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="THERMAL PROFILE" />
            <ItemsControl ItemsSource="{Binding SupportedProfiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="hw:ThermalProfile">
                  <Button Content="{Binding}"
                          Margin="0,0,6,0"
                          Padding="12,7"
                          Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SetProfileCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,10,0,0" FontSize="12" Opacity="0.7">
              <Run Text="Active:" />
              <Run Text="{Binding CurrentProfileName}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Classes="label" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Turbo is a Predator-tier profile and is not offered by this firmware." />
          </StackPanel>
        </Border>

        <!-- Fans -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="FAN CONTROL" />

            <Button Content="Toggle CoolBoost"
                    Command="{Binding ToggleCoolBoostCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="12,8" />
            <TextBlock Classes="label" Margin="0,4,0,12"
                       Text="CoolBoost sets both fans to Turbo. Unavailable while custom control is on." />

            <Button Content="Toggle custom fan control"
                    Command="{Binding ToggleCustomFanCommand}"
                    HorizontalAlignment="Stretch"
                    Padding="12,8" />

            <!-- Fan curve editor, per profile -->
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="6" Padding="10" Margin="0,12,0,0">
              <StackPanel>
                <CheckBox IsChecked="{Binding CurveEnabled, Mode=TwoWay}"
                          Content="Custom fan curve" />
                <TextBlock Classes="label" Margin="0,2,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding !CurveEnabled}"
                           Text="Off — the EC controls the fans. Turning this on stores a curve per thermal profile." />

                <StackPanel IsVisible="{Binding CurveEnabled}" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <TextBlock Grid.Column="0" Text="Profile" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding SupportedProfiles}"
                              SelectedItem="{Binding CurveProfile, Mode=TwoWay}" />
                  </Grid>

                  <TextBlock Classes="label" Text="CPU fan — drag the points" Margin="0,0,0,2" />
                <ctl:FanCurveEditor Points="{Binding FanCurveRows}"
                                    CurrentTemperature="{Binding CurveMarkerTemp}"
                                    Height="150" Margin="0,0,0,10" />

                <TextBlock Classes="label" Text="GPU fan" Margin="0,0,0,2" />
                <ctl:FanCurveEditor Points="{Binding GpuFanCurveRows}"
                                    CurrentTemperature="{Binding CurveMarkerTemp}"
                                    Height="150" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Save curves" Command="{Binding SaveFanCurveCommand}"
                          Padding="12,6" Margin="0,0,6,0" />
                  <Button Content="Clear" Command="{Binding ClearFanCurveCommand}" Padding="12,6" />
                </StackPanel>

                  <TextBlock Classes="label" Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="Each profile stores its own pair of curves. 0% stops the fan, as the EC itself does at idle; 1–29% cannot be programmed so it snaps to off or 30%. The dashed line marks the current CPU temperature." />
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding CustomFanEnabled}" Margin="0,12,0,0">
              <TextBlock Classes="label">
                <Run Text="CPU duty" />
                <Run Text="{Binding CpuDuty, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Minimum="30" Maximum="100" TickFrequency="5"
                      Value="{Binding CpuDuty, Mode=TwoWay}" />

              <TextBlock Classes="label">
                <Run Text="GPU duty" />
                <Run Text="{Binding GpuDuty, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Minimum="30" Maximum="100" TickFrequency="5"
                      Value="{Binding GpuDuty, Mode=TwoWay}" />

              <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,6,0,0"
                         Text="A watchdog reverts to Auto if this app stops responding or any sensor crosses 92 °C. Minimum duty is clamped to 30% so the fans cannot stall." />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Advanced: GPU / CPU tuning -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="ADVANCED — GPU / CPU TUNING" />

            <!-- GPU -->
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding GpuName}" />
            <TextBlock Classes="label" Text="{Binding GpuOffsetRange}" Margin="0,0,0,6" />

            <StackPanel IsEnabled="{Binding GpuAvailable}">
              <TextBlock Classes="label">
                <Run Text="Core offset" />
                <Run Text="{Binding GpuCoreOffset, StringFormat={}{0:+#;-#;0} MHz}" />
              </TextBlock>
              <Slider Minimum="-500" Maximum="500" TickFrequency="25"
                      Value="{Binding GpuCoreOffset, Mode=TwoWay}" />

              <TextBlock Classes="label">
                <Run Text="Memory offset" />
                <Run Text="{Binding GpuMemoryOffset, StringFormat={}{0:+#;-#;0} MHz}" />
              </TextBlock>
              <Slider Minimum="-500" Maximum="1000" TickFrequency="50"
                      Value="{Binding GpuMemoryOffset, Mode=TwoWay}" />

              <StackPanel IsVisible="{Binding GpuPowerAdjustable}">
                <TextBlock Classes="label">
                  <Run Text="Power limit" />
                  <Run Text="{Binding GpuPowerLimit, StringFormat={}{0:F0}%}" />
                </TextBlock>
                <Slider Minimum="{Binding GpuPowerMin}" Maximum="{Binding GpuPowerMax}"
                        TickFrequency="5" Value="{Binding GpuPowerLimit, Mode=TwoWay}" />
              </StackPanel>
              <TextBlock Classes="label" IsVisible="{Binding !GpuPowerAdjustable}">
                <Run Text="Power limit:" />
                <Run Text="{Binding GpuPowerRange}" />
              </TextBlock>

              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Apply" Command="{Binding ApplyGpuOffsetsCommand}"
                        Padding="14,6" Margin="0,0,6,0" />
                <Button Content="Reset" Command="{Binding ResetGpuOffsetsCommand}" Padding="14,6" />
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="label" Margin="0,6,0,14" TextWrapping="Wrap"
                       Text="Offsets apply to the highest performance state and are not persisted by the driver — a reboot clears them." />

            <!-- CPU: Windows power management -->
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding CpuName}" />
            <TextBlock Classes="label" Text="Managed through Windows power settings" Margin="0,0,0,8" />

            <StackPanel IsEnabled="{Binding WindowsPowerAvailable}">
              <TextBlock Classes="label" Text="Power mode" />
              <ComboBox HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        ItemsSource="{Binding PowerModes}"
                        SelectedItem="{Binding SelectedPowerMode, Mode=TwoWay}" />

              <TextBlock Classes="label" Text="Power plan" />
              <ComboBox HorizontalAlignment="Stretch" Margin="0,0,0,8"
                        ItemsSource="{Binding PowerPlans}"
                        SelectedItem="{Binding SelectedPowerPlan, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="local:PowerPlan">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <CheckBox IsChecked="{Binding TurboBoostEnabled, Mode=TwoWay}"
                        Content="Turbo boost" Margin="0,0,0,2" />
              <TextBlock Classes="label" Margin="0,0,0,8">
                <Run Text="Boost mode:" />
                <Run Text="{Binding BoostModeText}" />
              </TextBlock>

              <TextBlock Classes="label">
                <Run Text="Maximum processor state" />
                <Run Text="{Binding MaxProcessorState, StringFormat={}{0:F0}%}" />
              </TextBlock>
              <Slider Minimum="20" Maximum="100" TickFrequency="5"
                      Value="{Binding MaxProcessorState, Mode=TwoWay}" />

              <Button Content="Apply processor limit" Command="{Binding ApplyProcessorStateCommand}"
                      Padding="14,6" Margin="0,6,0,0" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Classes="label" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Capping maximum processor state holds boost clocks down, which lowers package power and temperature. Unlike SMU undervolting it needs no kernel driver, and it persists across reboots." />
          </StackPanel>
        </Border>

        <!-- Display -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="DISPLAY" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
              <TextBlock Grid.Column="0" Text="Refresh rate" FontSize="12"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding RefreshRates}"
                        SelectedItem="{Binding SelectedRefreshRate, Mode=TwoWay}" />
            </Grid>
            <TextBlock Classes="label" Margin="0,4,0,10">
              <Run Text="Resolution:" />
              <Run Text="{Binding DisplayMode}" />
            </TextBlock>

            <CheckBox IsChecked="{Binding AutoRefreshRateEnabled, Mode=TwoWay}"
                      Content="Switch refresh rate automatically" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  Margin="0,8,0,0"
                  IsEnabled="{Binding AutoRefreshRateEnabled}">

              <TextBlock Grid.Row="0" Grid.Column="0" Text="On AC"
                         VerticalAlignment="Center" Margin="0,0,10,6" FontSize="12" />
              <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding RefreshRates}"
                        SelectedItem="{Binding AcRefreshRate, Mode=TwoWay}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="On battery"
                         VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding RefreshRates}"
                        SelectedItem="{Binding BatteryRefreshRate, Mode=TwoWay}" />
            </Grid>

            <TextBlock Classes="label" Margin="0,6,0,12" TextWrapping="Wrap"
                       Text="Applied on a power source change, like the profile switch. A rate the panel does not advertise is skipped rather than forced." />

            <CheckBox IsChecked="{Binding OverdriveEnabled, Mode=OneWay}"
                      IsEnabled="{Binding OverdriveSupported}"
                      Command="{Binding ToggleOverdriveCommand}"
                      Content="Display overdrive" />

            <TextBlock Classes="label" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Overdrive reduces pixel response time. Its encoding is unverified on this model - confirm the checkbox reflects reality before relying on it." />
            <TextBlock Classes="label" Margin="0,4,0,0">
              <Run Text="GetGamingProfile raw:" />
              <Run Text="{Binding OverdriveRaw}" />
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Power auto-switching -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="POWER" />

            <Grid ColumnDefinitions="*,*" Margin="0,0,0,12">
              <StackPanel Grid.Column="0">
                <TextBlock Classes="label" Text="Power source" />
                <TextBlock Classes="metric" Text="{Binding PowerSourceText}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Adapter" />
                <TextBlock Classes="metric" Text="{Binding AdapterText}" />
              </StackPanel>
            </Grid>

            <CheckBox IsChecked="{Binding AutoSwitchEnabled, Mode=TwoWay}"
                      Content="Switch profile automatically" />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                  Margin="0,10,0,0"
                  IsEnabled="{Binding AutoSwitchEnabled}">

              <TextBlock Grid.Row="0" Grid.Column="0" Text="On AC"
                         VerticalAlignment="Center" Margin="0,0,10,6" FontSize="12" />
              <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SupportedProfiles}"
                        SelectedItem="{Binding AcProfile, Mode=TwoWay}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="On battery"
                         VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding SupportedProfiles}"
                        SelectedItem="{Binding BatteryProfile, Mode=TwoWay}" />
            </Grid>

            <TextBlock Classes="label" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Applies only when the power source changes, so a manual profile choice is never overridden a second later." />

            <CheckBox IsChecked="{Binding MinimiseToTray, Mode=TwoWay}"
                      Content="Close to tray instead of exiting"
                      Margin="0,10,0,0" />

            <CheckBox IsChecked="{Binding RunAtStartup, Mode=TwoWay}"
                      Content="Start with Windows" />
            <TextBlock Classes="label" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="Registers a scheduled task with highest privileges, so it starts elevated without a UAC prompt and opens straight to the tray." />
          </StackPanel>
        </Border>

        <!-- Battery -->
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="heading" Text="BATTERY" />

            <CheckBox IsChecked="{Binding HealthModeEnabled, Mode=OneWay}"
                      IsEnabled="{Binding HealthModeSupported}"
                      Command="{Binding ToggleHealthModeCommand}"
                      Content="Limit charge to 80%" />

            <TextBlock Classes="label" Margin="0,8,0,0">
              <Run Text="Design capacity:" />
              <Run Text="{Binding DesignCapacity}" />
            </TextBlock>

            <TextBlock Classes="label" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="This firmware reports no charge-bypass function, so 80% capping is the only wear-reduction mode available." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
